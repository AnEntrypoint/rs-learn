{"chunks":[{"body":"impl KvBackend for HostKv {\n    fn get(&self, namespace: &str, key: &str) -> Option<Vec<u8>> {\n        let bytes = wasm_host::kv_get(namespace, key).ok()?;\n        if bytes.is_empty() { None } else { Some(bytes) }\n    }\n\n    fn put(&mut self, namespace: &str, key: &str, val: &[u8]) -> Result<(), String> {\n        wasm_host::kv_put(namespace, key, val).map_err(|e| {\n            let msg = format!(\"host_kv_backend put failed: {}\", e);\n            wasm_host::log(&msg);\n            msg\n        })\n    }\n\n    fn list_prefix(&self, namespace: &str, prefix: &str) -> Vec<String> {\n        let raw = match wasm_host::kv_query(namespace, prefix) {\n            Ok(b) if !b.is_empty() => b,\n            _ => return Vec::new(),\n        };\n        let parsed: Vec<KvEntry> = match serde_json::from_slice(&raw) {\n            Ok(v) => v,\n            Err(_) => return Vec::new(),\n        };\n        parsed.into_iter()\n            .filter(|e| e.key.starts_with(prefix))\n            .map(|e| e.key)\n            .collect()\n    }\n}","emb":[-0.04849172383546829,-0.03604157641530037,0.02600797265768051,-0.025436943396925926,-0.04215650260448456,-0.00679946132004261,-0.060820020735263824,0.016249150037765503,0.02011578343808651,0.01664244756102562,0.04769683629274368,-0.11366201192140579,0.01312991976737976,-0.023624185472726822,0.023327095434069633,-0.018966255709528923,-0.048725079745054245,0.05365653708577156,-0.0671095997095108,0.022385230287909508,-0.011656301096081734,-0.0488327257335186,0.013754960149526596,-0.04449651762843132,0.03419521823525429,0.01758716255426407,-0.017572786659002304,-0.07435762882232666,-0.018886221572756767,-0.20048069953918457,0.014656830579042435,-0.10048114508390427,0.006072432268410921,0.06466151773929596,0.014671552926301956,-0.03692718222737312,-0.03250954672694206,-0.052377767860889435,-0.022275801748037338,0.03051314316689968,0.11822914332151413,0.009848241694271564,-0.005601906217634678,-0.03913576528429985,0.00