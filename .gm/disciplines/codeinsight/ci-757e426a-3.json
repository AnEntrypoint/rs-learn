pub fn kv_get(namespace: &str, key: &str) -> Result<Vec<u8>> {
    let packed = unsafe {
        host_kv_get(
            namespace.as_ptr(),
            namespace.len() as u32,
            key.as_ptr(),
            key.len() as u32,
        )
    };
    Ok(unsafe { take_bytes(packed) })
}