async function main() {
  try {
    const res = await fetch("./data/index.json", { cache: "no-cache" });
    if (!res.ok) throw new Error(`fetch index.json: ${res.status}`);
    state.data = await res.json();
    render();
  } catch (e) {
    state.error = e;
    render();
    throw e;
  }
}