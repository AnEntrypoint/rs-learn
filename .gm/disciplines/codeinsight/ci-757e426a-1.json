pub fn kv_query(namespace: &str, query: &str) -> Result<Vec<u8>> {
    let packed = unsafe {
        host_kv_query(
            namespace.as_ptr(),
            namespace.len() as u32,
            query.as_ptr(),
            query.len() as u32,
        )
    };
    Ok(unsafe { take_bytes(packed) })
}