fn first_three_losses_never_fire() {
        let mut d = DeepCore::new();
        assert!(!d.record_loss(0.5));
        assert!(!d.record_loss(100.0));
        assert!(!d.record_loss(0.5));
        assert_eq!(d.boundaries_detected, 0);
