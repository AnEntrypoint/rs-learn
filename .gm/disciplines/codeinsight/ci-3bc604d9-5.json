fn ms_to_parts(s: i64) -> (i64, i64, i64, i64, i64, i64) {
    let days = s.div_euclid(86400);
    let rem = s.rem_euclid(86400);
    let h = rem / 3600;
    let mi = (rem % 3600) / 60;
    let se = rem % 60;
    let (y, mo, d) = civil_from_days(days);
    (y, mo, d, h, mi, se)
}