pub fn save_attention(a: &Attention, seed: u32, key: &str) -> Result<()> {
    let blob = AttentionBlob {
        dim: a.dim,
        heads: a.heads,
        head_dim: a.head_dim,
        seed,
        we: a.we.clone(),
    };
    let json = serde_json::to_vec(&blob)?;
    wasm_host::kv_put(NS, key, &json)
}