fn output_residual_adds_query() {
        let a = Attention::new(64, 4, 16, 13);
        let q = mk_emb(64, 1);
        let ctx_empty = a.attend(&q, &Subgraph::default(), 0).unwrap();
        let q_norm = layer_norm(&q);
        for i in 0..64 {
            assert!((ctx_empty.vector[i] - q_norm[i]).abs() < 1e-5);
        }
    }