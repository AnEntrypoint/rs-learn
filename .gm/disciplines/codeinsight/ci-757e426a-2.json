pub fn kv_put(namespace: &str, key: &str, val: &[u8]) -> Result<()> {
    let rc = unsafe {
        host_kv_put(
            namespace.as_ptr(),
            namespace.len() as u32,
            key.as_ptr(),
            key.len() as u32,
            val.as_ptr(),
            val.len() as u32,
        )
    };
    if rc != 0 {
        Ok(())
    } else {
        Err(LlmError::Process(format!("host_kv_put failed rc={}", rc)))
    }
}